{
  "name": "diary-app",
  "private": true,
  "version": "1.4.1",
  "description": "本地优先的私人日记 App，以可交互的记忆星球呈现每一段记录。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boringHub/diary-app.git"
  },
  "bugs": {
    "url": "https://github.com/boringHub/diary-app/issues"
  },
  "homepage": "https://github.com/boringHub/diary-app#readme",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync android",
    "android": "npm run cap:sync && cap open android",
    "android:build:stable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Channel stable",
    "android:build:internal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Channel internal",
    "android:publish:internal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-internal.ps1",
    "release:validate": "node scripts/release-channel.mjs validate",
    "release:notes:stable": "node scripts/release-channel.mjs stable-notes",
    "release:notes:internal": "node scripts/release-channel.mjs internal-notes"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/network": "^8.0.1",
    "@ionic/vue": "^8.7.6",
    "@ionic/vue-router": "^8.7.6",
    "@vitejs/plugin-vue": "^5.2.3",
    "fflate": "^0.8.3",
    "ionicons": "^7.4.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.2.8"
  }
}
