---
import '../styles/global.css';
import '../styles/appearance.css';
interface Props { title?: string; description?: string }
const { title = '拾光笺 · 把日子过成自己的星空', description = '一款本地优先的私人日记 App。用十五种彩色表情、文字与照片收藏日常，让记忆成为星球上的光；在星语塔罗里，留一点时间倾听自己。' } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7ef" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && <meta property="og:image" content={new URL(`${base}social-card.svg`, Astro.site)} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}app-icon.png`} />
    <link rel="apple-touch-icon" href={`${base}app-icon.png`} />
    <script is:inline>
      (() => {
        let saved;
        try { saved = localStorage.getItem('shiguangjian.website.appearance'); } catch {}
        const appearance = saved === 'light' || saved === 'dark' ? saved : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.appearance = appearance;
        document.documentElement.style.colorScheme = appearance;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', appearance === 'dark' ? '#101d1b' : '#f7f7ef');
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <slot />
    <script>
      import '../scripts/appearance';
    </script>
  </body>
</html>
